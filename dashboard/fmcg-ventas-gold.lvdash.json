{
 "datasets": [
  {
   "name": "d_kpis",
   "displayName": "KPI 1 · Totales",
   "queryLines": [
    "SELECT round(SUM(revenue), 2) AS revenue_usd, SUM(quantity) AS total_units, COUNT(DISTINCT order_id) AS orders\n",
    "FROM fmcg.gold.fact_sales"
   ]
  },
  {
   "name": "d_top",
   "displayName": "KPI 2 · Top 10 productos",
   "queryLines": [
    "SELECT dp.product, dp.category, round(SUM(f.revenue), 2) AS revenue_usd\n",
    "FROM fmcg.gold.fact_sales f\n",
    "JOIN fmcg.gold.dim_products dp ON f.product_code = dp.product_code\n",
    "GROUP BY dp.product, dp.category\n",
    "ORDER BY revenue_usd DESC LIMIT 10"
   ]
  },
  {
   "name": "d_cat",
   "displayName": "KPI 3 · Categorías",
   "queryLines": [
    "SELECT dp.category, round(SUM(f.revenue), 2) AS revenue_usd, SUM(f.quantity) AS units\n",
    "FROM fmcg.gold.fact_sales f\n",
    "JOIN fmcg.gold.dim_products dp ON f.product_code = dp.product_code\n",
    "GROUP BY dp.category"
   ]
  },
  {
   "name": "d_mes",
   "displayName": "KPI 4 · Tendencia mensual",
   "queryLines": [
    "SELECT date_trunc('MONTH', date) AS month, round(SUM(revenue), 2) AS revenue_usd\n",
    "FROM fmcg.gold.fact_sales GROUP BY 1"
   ]
  }
 ],
